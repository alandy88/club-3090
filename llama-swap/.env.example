# Copy to .env (gitignored) and fill in real values.

# HF_TOKEN — Hugging Face token, used by llama-server / mtmd to fetch any
# gated tokenizer pieces. Leave blank if all your GGUFs are fully self-contained.
HF_TOKEN=

# MODEL_DIR — host path where the GGUFs live; mounted read-only at /models
# inside the container.
MODEL_DIR=/home/peteryu/llms

# PORT — host port to expose llama-swap on (container always listens on 8080).
PORT=8020

# LLAMA_CONFIG — which config-*.yaml to mount as the active proxy config.
# Override at runtime via `CONFIG=... make up`.
LLAMA_CONFIG=config-ik.yaml

# CUDA_VISIBLE_DEVICES — GPU index passed to compose `device_ids`.
CUDA_VISIBLE_DEVICES=0
